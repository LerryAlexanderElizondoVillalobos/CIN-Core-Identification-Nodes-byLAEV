{
  "configuration_id": "cin.initial-environment",
  "configuration_version": "1.0.1",
  "status": "corrected-documented-baseline-implementation-alignment-required",
  "revision_note": "Separates the published Web Environment from the future Local Environment; local runtime settings are scoped only to the local profile.",
  "repository": {
    "owner": "LerryAlexanderElizondoVillalobos",
    "name": "CIN-Core-Identification-Nodes-byLAEV",
    "branch": "main",
    "root_directory": "Core Identification Node Github/",
    "url": "https://github.com/LerryAlexanderElizondoVillalobos/CIN-Core-Identification-Nodes-byLAEV",
    "root_directory_role": "github-pages-publication-root"
  },
  "environment_profiles": {
    "web": {
      "profile_id": "cin.environment.web",
      "status": "published-static-interface",
      "delivery_model": "browser-based-static-web-publication",
      "provider": "GitHub Pages",
      "published_lobby_url": "https://lerryalexanderelizondo.github.io/CIN-Core-Identification-Nodes-byLAEV/",
      "artifact_source_directory": "Core Identification Node Github/",
      "local_http_server_required": false,
      "loopback_address": null,
      "local_port_strategy": null,
      "backend_api": {
        "configured": false,
        "endpoint": null,
        "backend_address": null
      },
      "direct_host_filesystem_access": false
    },
    "local": {
      "profile_id": "cin.environment.local",
      "status": "prototype",
      "intended_delivery": "future-installed-or-portable-local-application",
      "prototype": "prototype/linux-runtime",
      "platform_scope": "Linux x86_64",
      "server_type": "local-http",
      "bind_host": "127.0.0.1",
      "port_strategy": [
        1221,
        2112,
        0
      ],
      "address_template": "http://127.0.0.1:<selected-port>",
      "address_environment_output": "CIN_URL",
      "interface": "prototype/dist/index.html",
      "routes": {
        "health": "GET /health",
        "status": "GET /api/status",
        "lifecycle": "GET /api/lifecycle",
        "probe_write": "POST /api/probe/write",
        "probe_read": "GET /api/probe/read",
        "shutdown": "POST /api/runtime/shutdown"
      },
      "production_application": false,
      "backend_address_template": "http://127.0.0.1:<selected-port>"
    }
  },
  "storage": {
    "scope": "local-environment-prototype",
    "document_format": "JSON",
    "core_implementation": "prototype/cin-core/src/storage/TransactionalStore",
    "runtime_probe": "runtime-probe.record",
    "production_record_store": false,
    "web_environment_storage_backend": null,
    "remote_provider": null,
    "status": "prototype",
    "active_provider": null,
    "prototype_provider": "local-filesystem"
  },
  "data_root": {
    "scope": "local-environment-only",
    "canonical_core_environment_variable": "CIN_DATA_DIR",
    "resolution_order": [
      "explicit-application-configuration",
      "CIN_DATA_DIR",
      "platform-user-data-default"
    ],
    "defaults": {
      "windows": "%APPDATA%/CIN",
      "macos": "~/Library/Application Support/CIN",
      "linux": "$XDG_DATA_HOME/CIN or ~/.local/share/CIN"
    },
    "application_package_separated_from_user_data": true,
    "local_runtime_integration_discrepancy": {
      "linux_runtime_current_variable": "CIN_DATA_ROOT",
      "linux_runtime_current_fallback": "$XDG_DATA_HOME/cin or ~/.local/share/cin",
      "required_alignment": "Reconcile the local runtime with the shared core data-root contract within the Local Environment only"
    }
  },
  "authentication": {
    "provider": null,
    "status": "not-configured",
    "note": "No authentication provider is declared for the published Web Lobby or current local Linux runtime prototype."
  },
  "authorization": {
    "provider": null,
    "status": "not-configured",
    "note": "Authentication and operation-specific authorization remain separate configuration domains."
  },
  "connections": {
    "github_repository": "available",
    "web_environment_pages": "published-static-interface",
    "web_to_local_runtime": "not-configured-and-not-assumed",
    "web_backend_api": "not-configured",
    "local_linux_runtime": "prototype",
    "remote_node_transport": "not-configured",
    "status_is_runtime_observed": true
  },
  "components": {
    "repository_root": "/",
    "core_library": "prototype/cin-core",
    "central_engine_modules": [
      "data_root",
      "documents",
      "storage",
      "schema",
      "lifecycle",
      "recovery"
    ],
    "local_runtime": "prototype/linux-runtime",
    "published_web_lobby": "Core Identification Node Github/index.html",
    "local_runtime_interface": "prototype/dist/index.html",
    "services_directory": null,
    "guest": {
      "status": "planned-not-implemented",
      "directory": null
    },
    "cin_001": {
      "directory": "Core Identification Node Github/CIN 001/",
      "current_contents": [
        "README.md"
      ],
      "node_lobby": "not-yet-implemented",
      "node_configuration_engine": "not-yet-implemented"
    },
    "global_lobby_node_selector": "target-architecture-not-yet-implemented"
  },
  "configuration_scopes": {
    "global_lobby": "independent-global-scope",
    "cin_nodes": "one-independent-configuration-scope-per-node",
    "shared_code_implies_shared_state": false
  }
}
