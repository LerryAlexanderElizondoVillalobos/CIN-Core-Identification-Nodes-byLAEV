{
  "certificate_id": "cin:certificate:personal-registration:v1",
  "certificate_type": "cin.personal-registration",
  "certificate_version": "1.2.0",
  "title": "CIN Personal Document Generation and Node Binding Certificate",
  "status": "development-candidate",
  "description": "Consumes the CIN Node Birth artifact, requests an explicit MetaMask EIP-712 approval, deterministically derives a CIN personal-document identifier from the normalized EVM wallet address, and creates a wallet-approved candidate document with a node-binding agreement.",
  "execution": {
    "instruction": "RUN CERTIFICATE",
    "runner": "cin-personal-document-runner",
    "action": "request-wallet-approval-and-generate-cin-personal-document",
    "execution_profile": "github_pages_browser"
  },
  "input_profile": {
    "node_birth": {
      "document_type": "cin.node-birth-candidate",
      "required_status": "PREVIEW_NOT_ISSUED",
      "required_reference": "saved_cin_001_node_birth_candidate",
      "required": "The complete saved CIN 001 Node Birth candidate. This first browser implementation does not claim authoritative Node Birth Record status."
    },
    "wallet": {
      "provider": "window.ethereum",
      "account_request": "eth_requestAccounts",
      "chain_request": "eth_chainId",
      "signing_method": "eth_signTypedData_v4",
      "private_key_access": false,
      "requirement": "The wallet must explicitly approve the exact typed-data request. The private key remains inside the wallet."
    }
  },
  "identifier_derivation": {
    "profile_id": "cin.personal-document-identifier/1.0.0",
    "status": "implementation-candidate",
    "algorithm": "SHA-256",
    "formula": "SHA-256(UTF8(domain_separator) || raw_20_byte_normalized_evm_address)",
    "domain_separator": "CIN\\0PERSONAL-DOCUMENT-ID\\0v1\\0",
    "input": "Lowercase 20-byte EVM address returned by the wallet",
    "output_encoding": "lowercase hexadecimal",
    "document_id_prefix": "cin:personal-document:v1:",
    "personal_number_candidate": "CIN-P- followed by the first 24 uppercase hexadecimal characters of the derived digest",
    "determinism": "The same normalized wallet address always produces the same identifier under this profile. The signature bytes, nonce, timestamp and chain ID are not derivation inputs.",
    "privacy_note": "The wallet address is a pseudonymous public-key-derived identifier, not proof of civil identity or personhood."
  },
  "wallet_approval": {
    "protocol": "EIP-712",
    "method": "eth_signTypedData_v4",
    "approval_scope": "Approve creation of the CIN personal-document candidate and its technical binding to the referenced CIN 001 Node Birth candidate.",
    "signed_fields": [
      "operation",
      "certificate_id",
      "certificate_version",
      "node_birth_document_type",
      "node_birth_candidate_status",
      "node_birth_digest",
      "cin_bid",
      "personal_document_id",
      "wallet_address",
      "nonce",
      "requested_at",
      "expires_at"
    ],
    "nonce": "Cryptographically random 32-byte value generated for each approval request.",
    "expiry": "Five minutes after request creation.",
    "output_document_type": "cin.personal-document-candidate",
    "schema_version": "1.0.0",
    "signature_verification": "The browser records the signature returned by the wallet. Independent EIP-712 recovery/verification is a separate required step before authoritative issuance."
  },
  "processing": {
    "steps": [
      "Load Certificate 3 and the saved CIN 001 Node Birth candidate from the public repository.",
      "Validate the source document type, PREVIEW_NOT_ISSUED status and required CIN-NID/CIN-BID references.",
      "Canonicalize the complete source candidate and calculate its SHA-256 digest.",
      "Request explicit account access from MetaMask and read the selected EVM chain ID.",
      "Normalize the wallet address and deterministically derive the CIN personal-document identifier.",
      "Construct the EIP-712 approval payload binding the wallet address, operation, certificate, source birth digest, CIN-BID and derived document identifier.",
      "Request the wallet signature. The private key never leaves MetaMask and no blockchain transaction is submitted.",
      "Confirm the selected account remains available after signing.",
      "Generate the CIN personal-document candidate and the node-personal-document binding agreement.",
      "Download the generated JSON locally; do not commit wallet addresses, signatures or personal-document data to the public GitHub repository."
    ]
  },
  "output_profile": {
    "document_type": "cin.personal-document-candidate",
    "schema_version": "1.0.0",
    "initial_status": "WALLET_APPROVED_CANDIDATE_NOT_ISSUED",
    "binding_document_type": "cin.node-personal-document-binding",
    "binding_initial_status": "WALLET_APPROVED_CANDIDATE_PENDING_AUTHORITATIVE_NODE_BIRTH",
    "storage": "local_download_only",
    "public_repository_commit": false,
    "authoritative_person_registration": false,
    "global_number_reservation": false
  },
  "operational_boundaries": [
    "The wallet signature proves control of the signing address for the signed request only; it does not prove civil identity, legal personhood or personal attributes.",
    "The personal-document identifier is derived from the normalized wallet address, not from signature bytes. Repeated signatures may differ while the derived identifier remains stable.",
    "The chain ID is included in the EIP-712 approval domain but is intentionally excluded from the stable identifier derivation.",
    "The source Node Birth artifact is currently a PREVIEW_NOT_ISSUED candidate. The binding agreement remains a candidate until authoritative Node Birth is completed and verified.",
    "The browser does not independently recover/verify the signer from the EIP-712 signature. Independent verification is mandatory before authoritative registration.",
    "The generated JSON contains a wallet address and signature and is downloaded locally. It is not committed to the public GitHub Pages repository.",
    "No private key is requested, exported, stored or embedded in the certificate or Lobby.",
    "No blockchain transaction, token transfer, smart-contract call or gas payment is initiated.",
    "A locally derived CIN-P candidate is not globally reserved or a government-issued document.",
    "The binding agreement is a technical association record, not a legal contract or proof of civil relationship."
  ]
}
